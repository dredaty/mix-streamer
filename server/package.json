{
  "name": "mix-streamer-server",
  "version": "1.0.0",
  "private": true,
  "description": "Local relay server + web player for Mix Streamer VST3",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "start:local": "npm run build && node dist/index.js --no-tunnel",
    "test": "npm run build && node dist/selftest.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
